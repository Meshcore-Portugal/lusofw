{
	"name": "MeshCore | Luso Firmware",
	"image": "mcr.microsoft.com/devcontainers/python:3-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/node:2.1.0": {},
		"ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
			"packages": [
				"sudo",
				"ripgrep"
			]
		}
	},
	"runArgs": [
		"--privileged",
		"--network=host",
		"--device=/dev/bus/usb",
		"--group-add=986",
		"--group-add=20",
		"--env-file",
		"${localWorkspaceFolder}/.env.dev"
	],
	"mounts": [],
	"onCreateCommand": {
		"claude": "bash -c 'cd .devcontainer && bash claude.sh'",
		"platformio": "pipx install platformio esptool",
		"timezone": "sudo ln -snf /usr/share/zoneinfo/Europe/Lisbon /etc/localtime && echo 'Europe/Lisbon' | sudo tee /etc/timezone",
	},
	"customizations": {
		"vscode": {
			"settings": {
				"editor.formatOnSave": false,
				"platformio-ide.disablePIOHomeStartup": true,
				"remote.autoForwardPorts": false,
				"workbench.colorCustomizations": {
					"titleBar.activeBackground": "#0d1a2b",
					"titleBar.activeForeground": "#ffffff",
					"titleBar.inactiveBackground": "#0d1a2b99",
					"titleBar.inactiveForeground": "#ffffff99"
				}
			},
			"extensions": [
				"Anthropic.claude-code",
				"github.vscode-github-actions",
				"GitHub.vscode-pull-request-github",
				"openai.chatgpt",
				"platformio.platformio-ide"
			],
			"unwantedRecommendations": [
				"ms-vscode.cpptools-extension-pack"
			]
		}
	}
}
